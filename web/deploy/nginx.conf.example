# Review-only template for a separate Next.js service. Nothing here deploys it.
# Replace the hostname/certificates/log paths; run nginx -t before an approved release.
# Use a current nginx with http2 and ssl_reject_handshake support.
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/bcs-error.log warn;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    ssl_protocols TLSv1.2 TLSv1.3;
    autoindex off;
    sendfile on;
    client_max_body_size 31m;
    client_header_timeout 10s;
    client_body_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 65s;

    # Webhook paths contain bearer credentials. Redact them before access logging.
    map $uri $bcs_log_path {
        default $uri;
        ~^/api/webhooks/zaprite/ /api/webhooks/zaprite/[redacted];
    }
    # Do not log cookies, Authorization headers, request bodies or query strings.
    log_format bcs escape=json '{"time":"$time_iso8601","method":"$request_method","path":"$bcs_log_path","status":$status,"bytes":$body_bytes_sent,"seconds":$request_time}';
    access_log /var/log/nginx/bcs-access.log bcs;

    limit_req_zone $binary_remote_addr zone=bcs_login:10m rate=5r/m;
    limit_req_status 429;

    upstream bcs_next {
        server 127.0.0.1:3100;
        keepalive 16;
    }

    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;
        return 444;
    }

    server {
        listen 80;
        listen [::]:80;
        server_name center.example.invalid;
        return 308 https://center.example.invalid$request_uri;
    }

    server {
        listen 443 ssl default_server;
        listen [::]:443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        http2 on;
        server_name center.example.invalid;
        ssl_certificate /etc/letsencrypt/live/center.example.invalid/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/center.example.invalid/privkey.pem;
        ssl_session_cache shared:BCS_TLS:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;
        add_header Strict-Transport-Security "max-age=31536000" always;

        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_set_header Connection "";
        proxy_set_header Host center.example.invalid;
        proxy_set_header X-Forwarded-Host center.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;

        # This nginx must terminate the public connection directly. Do not enable
        # real_ip_header or derive identity from caller-supplied forwarding headers.
        # A CDN/load balancer requires a separately reviewed trusted-proxy design.
        proxy_set_header X-BCS-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";

        location ~ (^|/)\. { return 404; }
        location ~* \.(?:db(?:-(?:wal|shm))?|sqlite3?|sql|env|log|bak|backup|pem|key)$ { return 404; }
        location ^~ /data/ { return 404; }
        location ^~ /backups/ { return 404; }
        location ^~ /node_modules/ { return 404; }
        location ^~ /dev-tools/ { return 404; }

        location = /api/admin/login {
            limit_req zone=bcs_login burst=5 nodelay;
            proxy_pass http://bcs_next;
        }

        location ^~ /api/webhooks/zaprite/ {
            # nginx error messages can include the original request URI. The
            # redacted access log retains delivery status/timing for monitoring.
            error_log /dev/null crit;
            proxy_pass http://bcs_next;
        }

        # Next serves public assets and /images through its validated image route.
        # There is deliberately no filesystem alias or legacy Express fallback.
        location / { proxy_pass http://bcs_next; }
    }
}
