{
  "name": "bitcoin-center-seoul-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run lint",
    "test": "playwright test",
    "audit": "npm audit",
    "doctor": "react-doctor . --verbose",
    "analyze": "ANALYZE=true next build --webpack"
  },
  "dependencies": {
    "lucide-react": "1.23.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-doctor": "0.9.13",
    "react-grab": "0.2.0",
    "react-scan": "0.5.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2"
  }
