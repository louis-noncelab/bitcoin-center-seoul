{
  "name": "bitcoin-center-seoul-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run lint",
    "test": "playwright test",
    "audit": "npm audit",
    "doctor": "react-doctor . --verbose",
    "analyze": "ANALYZE=true next build --webpack",
    "review": "node --import tsx scripts/events-review.mjs",
    "admin:password": "node --import tsx scripts/admin-password.ts",
    "test:security": "node --conditions=react-server --import tsx --test tests/admin-security.mjs",
    "backup": "node --import tsx scripts/events-backup.ts",
    "test:backup": "node --test tests/events-backup.mjs",
    "test:events": "playwright test --config playwright.events.config.ts",
    "postinstall": "node scripts/patch-next-image-optimizer.mjs apply",
    "test:image-optimizer": "node --test tests/image-optimizer-abort.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "lucide-react": "1.23.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-doctor": "0.9.13",
    "react-grab": "0.2.0",
    "react-scan": "0.5.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.2"
  }
}
