# ── Existing public site (events, collection, notices, reviews — SQLite) ──
# Create a private hash file with npm run admin:password; never put the raw password here.
ADMIN_PASSWORD_HASH=
APP_ORIGIN=https://center.example.invalid
BCS_EVENTS_DB=/var/lib/bitcoin-center-seoul/events.db
BCS_EVENTS_UPLOADS=/var/lib/bitcoin-center-seoul/images
# Requires nginx to overwrite X-BCS-Client-IP and the app to listen only on loopback.
BCS_TRUST_PROXY=true

# ── Commerce slice (cart, orders, payments — PostgreSQL via Prisma) ──
# review  = in-process fixtures, no network. Requires APP_MODE review or test.
# sandbox = real Zaprite sandbox organization from a local origin. Zaprite only.
# live    = production. Requires APP_MODE production, HTTPS origin and SMTP.
APP_MODE=test
PAYMENT_MODE=review
PAYMENT_PROVIDER=zaprite
DATABASE_URL=postgresql://user@127.0.0.1:5432/center_dev
DATA_DIR=/var/lib/bitcoin-center-seoul/commerce
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TRUST_PROXY=false
EMAIL_MODE=capture
QUOTE_TTL_MINUTES=10
PAYMENT_PENDING_TTL_MINUTES=30
# Fixed KRW/BTC used only by review mode; forbidden in production.
REVIEW_KRW_PER_BTC=150000000

# ── Zaprite ── https://api.zaprite.com/openapi.json
ZAPRITE_API_URL=https://api.zaprite.com
ZAPRITE_API_KEY=
ZAPRITE_CHECKOUT_ID=
# Zaprite publishes no webhook signature, so the delivery URL carries an unguessable
# secret that is compared in constant time:
#   POST /api/webhooks/zaprite/<ZAPRITE_WEBHOOK_SECRET>
# Generate with: openssl rand -hex 32
ZAPRITE_WEBHOOK_SECRET=
# Required in sandbox mode. order.change deliveries whose orgId differs are refused.
ZAPRITE_ORG_ID=

# ── Lightning address (LUD-06/16 pay + LUD-21 settlement proof) ──
# Live mode only: a lightning address is mainnet money with no test network.
# List every origin the address touches — the callback and verify host often differ
# from the address domain (blink.sv resolves its callback to lnurl.blink.sv).
LNURL_LIGHTNING_ADDRESS=
LNURL_ALLOWED_ORIGINS=

# ── SMTP: required when EMAIL_MODE=smtp ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
