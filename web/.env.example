# ─────────────────────────────────────────────────────────────────────────────
# bitcoin-center-seoul / web
#
# [채움] = 운영자가 값을 넣어야 하는 항목
# [생성] = 명령으로 만들어 넣는 항목 (값을 문서·채팅에 붙여넣지 말 것)
# 표시가 없으면 아래 기본값 그대로 둔다.
#
# 주의: scrypt 해시 등 일부 값에는 `$`가 들어간다. 셸 소싱과 dotenv 변수 확장이
# 값을 망가뜨리므로 작은따옴표로 감싸고 `\$`로 이스케이프한다. 그리고
# `npm run dev` / `npm run start`는 이 파일을 셸로 source 하지 말고 그냥 실행한다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 기존 공개 사이트 (행사·컬렉션·공지·후기 — SQLite) ──
# [생성] npm run admin:password -- --output /절대경로/admin-password.env
ADMIN_PASSWORD_HASH=
# [채움] 공개 주소. 운영에서는 https, 경로·쿼리 없이 오리진만.
APP_ORIGIN=https://center.example.invalid
# [채움] SQLite 파일과 업로드 디렉터리의 절대 경로
BCS_EVENTS_DB=/var/lib/bitcoin-center-seoul/events.db
BCS_EVENTS_UPLOADS=/var/lib/bitcoin-center-seoul/images
# nginx가 X-BCS-Client-IP를 덮어쓰고 앱이 루프백만 바라볼 때 true
BCS_TRUST_PROXY=true

# ── 상점 (장바구니·주문·결제 — PostgreSQL / Prisma) ──
# review  = 네트워크를 타지 않는 내장 fixture. APP_MODE review|test 에서만.
# sandbox = Zaprite 샌드박스 조직에 실제 호출. 로컬 오리진 허용. Zaprite 전용.
# live    = 운영. APP_MODE production + https 오리진에서만.
APP_MODE=test
PAYMENT_MODE=review
PAYMENT_PROVIDER=zaprite
# [채움] PostgreSQL 접속 문자열. review/test 모드에서는 로컬 호스트만 허용.
DATABASE_URL=postgresql://user@127.0.0.1:5432/center_dev
# [채움] 상점이 쓰는 데이터 디렉터리의 절대 경로
DATA_DIR=/var/lib/bitcoin-center-seoul/commerce
# [생성] openssl rand -base64 32
# 주문 안내 메일 본문을 암호화해 보관하는 키다. 바꾸면 기존 보관분을 못 읽는다.
TOKEN_ENCRYPTION_KEY=
TRUST_PROXY=false
# capture = 발송하지 않고 보관만 한다. 발송 worker가 없어 운영에서도 capture다.
EMAIL_MODE=capture
QUOTE_TTL_MINUTES=10
PAYMENT_PENDING_TTL_MINUTES=30
# review 모드 전용 고정 환율. 운영에서는 값이 있으면 설정이 거부된다.
REVIEW_KRW_PER_BTC=150000000

# ── Zaprite ── 계약: https://api.zaprite.com/openapi.json
ZAPRITE_API_URL=https://api.zaprite.com
# [채움] app.zaprite.com → 설정 → API 에서 발급. 조직 하나당 키 하나.
ZAPRITE_API_KEY=
# [채움] 주문에 쓸 커스텀 체크아웃 ID
ZAPRITE_CHECKOUT_ID=
# [채움] 조직 ID. order.change 웹훅의 orgId와 대조해 다른 조직 이벤트를 거른다.
#        주문을 하나 만들면 응답의 orgId로 확인할 수 있다.
ZAPRITE_ORG_ID=
# [생성] openssl rand -hex 32
# Zaprite는 웹훅 서명을 제공하지 않는다(공식 스펙 확인). 그래서 이 값을 웹훅 URL
# 경로에 넣고 상수시간으로 대조한다. Zaprite에 등록할 주소:
#   https://<공개주소>/api/webhooks/zaprite/<ZAPRITE_WEBHOOK_SECRET>
ZAPRITE_WEBHOOK_SECRET=

# ── 라이트닝 주소 (LUD-06/16 결제 + LUD-21 정산 확인) ──
# live 모드 전용. 라이트닝 주소는 테스트망이 없어 샌드박스로 쓸 수 없다.
# [채움] 수취 라이트닝 주소
LNURL_LIGHTNING_ADDRESS=
# [채움] 그 주소가 쓰는 모든 오리진. .well-known / callback / verify 호스트가
#        다를 수 있으니 전부 넣는다. 쉼표로 구분.
LNURL_ALLOWED_ORIGINS=

# ── SMTP ── EMAIL_MODE=smtp 로 바꿀 때만 필요. 현재는 발송하지 않으므로 비워 둔다.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
