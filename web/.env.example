# Create a private hash file with npm run admin:password; never put the raw password here.
ADMIN_PASSWORD_HASH=
APP_ORIGIN=https://center.example.invalid
BCS_EVENTS_DB=/var/lib/bitcoin-center-seoul/events.db
BCS_EVENTS_UPLOADS=/var/lib/bitcoin-center-seoul/images
# Requires nginx to overwrite X-BCS-Client-IP and the app to listen only on loopback.
BCS_TRUST_PROXY=true
