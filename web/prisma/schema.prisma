// Shop, orders, payments, and the public center content live in this database.
//
// Deliberate omissions vs. the backup schema: customer accounts and sessions (guest-only
// checkout), bookings, BTCPay. `accountId` / `bookingId` remain as plain nullable columns so
// the ported server code compiles unchanged and the seam stays open.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentFormat {
  PLAIN
  MARKDOWN
}

enum PriceKind {
  FREE
  KRW_FIXED
  BTC_FIXED
}

enum Fulfillment {
  PICKUP
  DOMESTIC
  INTERNATIONAL
}

enum FulfillmentStatus {
  UNFULFILLED
  READY
  SHIPPED
  DELIVERED
  COLLECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  REVIEW
}

enum RefundStatus {
  NONE
  PENDING
  COMPLETED
}

// LNURL is a generic LUD-06/LUD-16/LUD-21 lightning-address payer, not Blink-specific.
enum PaymentProvider {
  LNURL
  ZAPRITE
}

// SANDBOX drives real provider traffic against a Zaprite sandbox organization while the app
// still runs on a local origin. The unique constraints below are per mode, so sandbox rows can
// never collide with live ones.
enum PaymentMode {
  REVIEW
  SANDBOX
  LIVE
}

enum PaymentStatus {
  NEW
  CREATING
  PENDING
  PROCESSING
  PAID
  EXPIRED
  FAILED
  REVIEW
}

enum CouponDiscountKind {
  PERCENT
  KRW
  SATS
}

enum BtcPriceSource {
  UPBIT
  BITHUMB
  FIXED
}

enum ProductDisplayUnit {
  KRW
  SATS
  BTC
}

enum NotificationChannel {
  DISCORD
  MATTERMOST
  GENERIC
}

enum EmailStatus {
  CAPTURED
  PENDING
  PROCESSING
  SENT
  FAILED
}

model SiteSetting {
  id                   String             @id @default("site")
  guestPurchaseAllowed Boolean            @default(true)
  maintenanceMode      Boolean            @default(false)
  paymentProvider      PaymentProvider?
  btcPriceSource       BtcPriceSource     @default(UPBIT)
  fixedKrwPerBtc       Decimal?           @db.Decimal(30, 10)
  productDisplayUnit   ProductDisplayUnit @default(SATS)
  lightningAddressId    String?              @unique
  lightningAddress      LightningAddress?    @relation(fields: [lightningAddressId], references: [id], onDelete: SetNull)
  notificationChannel   NotificationChannel  @default(GENERIC)
  notificationWebhook   String?
  notificationEmail     String               @default("hello@noncelab.com")
  updatedAt            DateTime           @updatedAt
}

model LightningAddress {
  id             String       @id @default(cuid())
  label          String
  address        String       @unique
  allowedOrigins String
  createdAt      DateTime     @default(now())
  siteSetting    SiteSetting?
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// Last live ticker that priced an order. Used only when Upbit and Bithumb are both unreachable.
model ExchangeRateCache {
  id         String   @id
  krwPerBtc  Decimal  @db.Decimal(30, 10)
  source     String
  observedAt DateTime
  updatedAt  DateTime @updatedAt
}

model ProductCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameKo    String
  nameEn    String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([active, sortOrder])
}

model Product {
  id                  String           @id @default(cuid())
  slug                String           @unique
  titleKo             String
  titleEn             String
  descriptionKo       String
  descriptionEn       String
  contentFormat       ContentFormat    @default(PLAIN)
  imageUrl            String           @default("")
  images              String[]         @default([])
  published           Boolean          @default(false)
  listed              Boolean          @default(true)
  priceKind           PriceKind
  priceAmount         BigInt
  listPriceAmount     BigInt?
  allowedFulfillments Fulfillment[]
  memberOnly          Boolean          @default(false)
  categoryId          String?
  category            ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  variants            ProductVariant[]

  @@index([categoryId])
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku             String      @unique
  optionLabelKo   String      @default("")
  optionLabelEn   String      @default("")
  stockOnHand     Int         @default(0)
  reservedStock   Int         @default(0)
  billableWeightG Int         @default(0)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]

  @@index([productId])
}

model ShippingZone {
  id        String            @id @default(cuid())
  nameKo    String
  nameEn    String
  active    Boolean           @default(true)
  countries ShippingCountry[]
  rates     ShippingRate[]
}

model ShippingCountry {
  code               String       @id
  zoneId             String
  zone               ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  requiresPostalCode Boolean      @default(true)

  @@index([zoneId])
}

model ShippingRate {
  id         String       @id @default(cuid())
  zoneId     String
  zone       ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  maxWeightG Int
  amountKrw  BigInt

  @@unique([zoneId, maxWeightG])
}

model Quote {
  id            String    @id @default(cuid())
  accountId     String?
  ownerHash     String?
  input         Json
  snapshot      Json
  amountSats    BigInt
  amountKrw     BigInt?
  rateKrwPerBtc Decimal?  @db.Decimal(30, 10)
  rateSource    String?
  rateTimestamp DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  order         Order?

  @@index([expiresAt])
}

model Order {
  id                   String            @id @default(cuid())
  accountId            String?
  quoteId              String            @unique
  quote                Quote             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  customerName         String
  customerEmail        String
  customerEmailHash    String?
  customerPhone        String            @default("")
  locale               String            @default("ko")
  status               OrderStatus       @default(PENDING_PAYMENT)
  refundStatus         RefundStatus      @default(NONE)
  refundedAt           DateTime?
  amountSats           BigInt
  amountKrw            BigInt?
  fulfillment          Fulfillment
  fulfillmentStatus    FulfillmentStatus @default(UNFULFILLED)
  address              Json?
  shippingSnapshot     Json
  billableWeightG      Int               @default(0)
  shippingAmountKrw    BigInt            @default(0)
  shippingAmountSats   BigInt            @default(0)
  carrier              String?
  trackingNumber       String?
  fulfilledAt          DateTime?
  holdExpiresAt        DateTime?
  idempotencyScope     String
  idempotencyKey       String
  requestHash          String
  customerNotes        String            @default("")
  confirmationCode     String?           @unique
  checkedInAt          DateTime?
  accessTokenHash      String            @unique
  accessTokenExpiresAt DateTime          @default(dbgenerated("(now() + interval '30 days')"))
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  privacyRedactedAt    DateTime?
  privacyHold          Boolean           @default(false)
  items                OrderItem[]
  payments             Payment[]
  couponUsage          CouponUsage?

  @@unique([idempotencyScope, idempotencyKey])
  @@index([customerEmailHash])
  @@index([accountId, createdAt])
  @@index([status, holdExpiresAt])
  @@index([privacyRedactedAt, createdAt])
}

// Purpose-limited encrypted records, deliberately absent from ordinary order projections.
model PrivacyLegalRecord {
  id               String   @id @default(cuid())
  orderId          String
  kind             String
  encryptedPayload String
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@unique([orderId, kind])
  @@index([expiresAt])
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity        Int
  sku             String
  titleKo         String
  titleEn         String
  optionLabelKo   String
  optionLabelEn   String
  priceKind       PriceKind
  unitPriceAmount BigInt
  amountSats      BigInt
  snapshot        Json

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id              String          @id @default(cuid())
  orderId         String?
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  bookingId       String?
  provider        PaymentProvider
  mode            PaymentMode
  externalId      String?
  creationKey     String          @unique
  amountSats      BigInt
  currency        String          @default("BTC")
  metadata        Json
  status          PaymentStatus   @default(NEW)
  creationUnknown Boolean         @default(false)
  reviewReason    String?
  checkoutUrl     String?
  paymentRequest  String?
  verifyUrl       String?
  paymentHash     String?
  expiresAt       DateTime
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  events          PaymentEvent[]

  @@unique([provider, mode, externalId])
  @@unique([provider, mode, paymentHash])
  @@index([orderId])
  @@index([status, expiresAt])
}

model PaymentEvent {
  id          String          @id @default(cuid())
  paymentId   String
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  provider    PaymentProvider
  mode        PaymentMode
  eventKey    String
  summary     Json
  processedAt DateTime        @default(now())

  @@unique([provider, mode, eventKey])
  @@index([paymentId])
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  nameKo            String
  nameEn            String
  discountKind      CouponDiscountKind
  discountValue     BigInt
  minPurchaseAmount BigInt             @default(0)
  maxDiscountAmount BigInt?
  usageLimit        Int?
  perUserLimit      Int                @default(1)
  validFrom         DateTime
  validUntil        DateTime
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  usages            CouponUsage[]

  @@index([active, validFrom, validUntil])
}

model CouponUsage {
  id           String   @id @default(cuid())
  couponId     String
  coupon       Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  accountId    String?
  discountSats BigInt
  createdAt    DateTime @default(now())

  @@index([couponId])
  @@index([accountId])
}

model EmailOutbox {
  id               String      @id @default(cuid())
  orderId          String?
  eventKey         String      @unique
  to               String
  locale           String      @default("ko")
  kind             String
  payload          Json
  encryptedPayload String?
  status           EmailStatus @default(PENDING)
  attempts         Int         @default(0)
  nextAttemptAt    DateTime    @default(now())
  claimToken       String?
  claimedAt        DateTime?
  sentAt           DateTime?
  lastError        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, nextAttemptAt])
  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  summary    Json
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
}

model CenterEvent {
  id                   Int      @id @default(autoincrement())
  revision             Int      @default(1)
  registrationClosed   Boolean  @default(false)
  title                String
  titleEn              String
  date                 String
  time                 String
  venueType            String   @default("external")
  location             String
  locationEn           String
  description          String
  descriptionEn        String
  image                String   @default("")
  link                 String   @default("")
  ticketPriceKrw       String   @default("")
  ticketCapacity       Int      @default(0)
  externalPayment      Boolean  @default(true)
  isOnline             Boolean  @default(false)
  onlineUrl            String   @default("")
  onlineInstructions   String   @default("")
  onlineInstructionsEn String   @default("")
  tags                 String   @default("[]")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("center_events")
}

model CenterHighlight {
  id            Int      @id @default(autoincrement())
  revision      Int      @default(1)
  title         String
  titleEn       String
  meta          String   @default("")
  metaEn        String   @default("")
  category      String   @default("행사")
  categoryEn    String   @default("Event")
  date          String   @default("")
  startDate     String   @default("")
  endDate       String   @default("")
  host          String   @default("비트코인 센터 서울")
  hostEn        String   @default("Bitcoin Center Seoul")
  description   String
  descriptionEn String
  image         String   @default("")
  link          String   @default("")
  icon          String   @default("calendar")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Int      @default(1) @map("is_active")
  tags          String   @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("center_highlights")
}

model ContentImage {
  kind      String
  contentId Int    @map("content_id")
  position  Int
  path      String

  @@id([kind, contentId, position])
  @@map("content_images")
}

model ContentSlug {
  kind      String
  slug      String
  contentId Int     @map("content_id")
  isCurrent Boolean @map("is_current")

  @@id([kind, slug])
  @@map("content_slugs")
}

model Notice {
  id            Int      @id @default(autoincrement())
  revision      Int      @default(1)
  slug          String   @unique
  title         String
  titleEn       String   @default("")
  description   String
  descriptionEn String   @default("")
  isActive      Int      @default(0) @map("is_active")
  tags          String   @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("notices")
}

model NoticeSlug {
  slug     String @id
  noticeId Int    @map("notice_id")

  @@map("notice_slugs")
}

model CollectionItem {
  id            Int      @id @default(autoincrement())
  revision      Int      @default(1)
  kind          String
  slug          String   @default("")
  purchaseUrl   String   @default("")
  soldOut       Boolean  @default(false)
  title         String
  titleEn       String   @default("")
  creator       String   @default("")
  creatorEn     String   @default("")
  description   String   @default("")
  descriptionEn String   @default("")
  images        String   @default("[]")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Int      @default(0) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("collection_items")
}

model VisitReview {
  id             Int      @id @default(autoincrement())
  revision       Int      @default(1)
  kind           String
  url            String
  author         String
  date           String   @default("")
  title          String
  titleEn        String   @default("")
  summary        String
  summaryEn      String   @default("")
  slug           String   @default("")
  description    String   @default("")
  descriptionEn  String   @default("")
  featureTitle   String   @default("") @map("feature_title")
  featureTitleEn String   @default("") @map("feature_titleEn")
  image          String   @default("")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Int      @default(0) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("visit_reviews")
}

model ReviewSlug {
  slug     String @id
  reviewId Int    @map("review_id")

  @@map("review_slugs")
}

model ReviewSelection {
  id         Int     @id
  revision   Int     @default(1)
  featuredId Int?    @map("featured_id")
  homeIds    String  @default("[]") @map("home_ids")

  @@map("review_selection")
}

model CenterOpeningOverride {
  date   String @id
  status String

  @@map("center_opening_overrides")
}

model AdminSession {
  tokenHash         String @id @map("token_hash")
  expiresAt         BigInt @map("expires_at")
  lastSeenAt        BigInt @default(0) @map("last_seen_at")
  credentialVersion String @default("") @map("credential_version")

  @@map("admin_sessions")
}

model AdminLoginAttempt {
  clientHash    String @id @map("client_hash")
  windowStarted BigInt @map("window_started")
  failures      Int
  blockedUntil  BigInt @map("blocked_until")

  @@map("admin_login_attempts")
}
